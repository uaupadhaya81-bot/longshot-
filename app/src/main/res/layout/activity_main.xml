<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="Offline Longshot Capture"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/instruction_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title_text"
        android:layout_marginTop="12dp"
        android:text="1. Enable Accessibility Service\n2. Allow overlay permission\n3. Set preferences and tap Start"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@android:color/darker_gray" />

    <LinearLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/instruction_text"
        android:layout_marginTop="30dp"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_speed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scroll Speed: 1x"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/sb_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:max="7"
            android:progress="1" />

        <TextView
            android:id="@+id/tv_window_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanner Window Size: ±20px (40px Total)"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/sb_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:max="80"
            android:progress="15" />

        <TextView
            android:id="@+id/tv_last_window_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Last Frame Window Size: ±15px (30px Total)"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/sb_last_window"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="80"
            android:progress="10" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/settings_container"
        android:layout_marginTop="40dp"
        android:padding="16dp"
        android:text="Start Longshot Service"
        android:textSize="18sp" />

</RelativeLayout>
